# ==========================================
# Database & Storage
# ==========================================
DATABASE_PATH=/app/data/app.db
UPLOAD_DIR=/app/data/uploads

# ==========================================
# Qdrant
# ==========================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=document_chunks

# ==========================================
# Embedding
# ==========================================
EMBEDDING_MODEL_DIR=/app/models/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
EMBEDDING_MODEL_ID=Qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
EMBEDDING_DIM=384
EMBEDDING_MAX_TOKENS=128
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=2

# ==========================================
# Chunking
# ==========================================
CHUNK_TARGET_TOKENS=90
CHUNK_MAX_TOKENS=100
CHUNK_OVERLAP_TOKENS=16
BREADCRUMB_MAX_TOKENS=20
LOW_TEXT_PAGE_CHARS=40

# ==========================================
# Retrieval & Validation
# ==========================================
RETRIEVAL_DENSE_TOP_K=100
RETRIEVAL_LEXICAL_TOP_K=100
RRF_K=60
EVIDENCE_MAX=25
LEXICAL_SUPPORT_MIN_RATIO=0.2
CLAIM_MAX_CHARS=1500
MISSING_MAX_CHARS=160
QUOTE_MAX_CHARS=600

# ==========================================
# Limits
# ==========================================
MAX_FILE_MB=80
MAX_PDF_PAGES=2000
MAX_DOCUMENTS_PER_CONVERSATION=50
MAX_CHUNKS_PER_CONVERSATION=100000
MAX_QUESTION_CHARS=1000
INGEST_TIMEOUT_SECONDS=900
QUESTION_DEADLINE_SECONDS=150

# ==========================================
# API & Security
# ==========================================
ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# ==========================================
# Language Model (LLM)
# ==========================================
# Put your real values in .env, NOT here.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_JSON_MODE=auto
LLM_EXTRA_BODY={}
LLM_DATA_POLICY_ACK=false

# Only for testing and evaluation
RUN_LIVE_LLM=0

# ==========================================
# Frontend (Web)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1